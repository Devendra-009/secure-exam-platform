# Local development only. Never commit a real .env file.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/secure_exam_platform
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_ISSUER=secure-exam
JWT_AUDIENCE=secure-exam-client
CLIENT_URL=http://127.0.0.1:5173,http://localhost:5173
DB_POOL_MAX=10
TRUST_PROXY=0

# Docker Compose only
POSTGRES_DB=secure_exam_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Used only when you explicitly run the admin seed script locally.
SEED_ADMIN_NAME=Platform Administrator
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-me-before-running-seed

# Electron development overrides.
ELECTRON_START_URL=http://127.0.0.1:5173
ELECTRON_API_URL=http://127.0.0.1:5000/api
